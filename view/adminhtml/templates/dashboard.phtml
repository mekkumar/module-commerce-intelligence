            <?php if ($maxTrendRevenue > 0): ?>

                <?php
                $chartWidth = 1000;
                $chartHeight = 250;
                $chartLeft = 30;
                $chartRight = 20;
                $chartTop = 20;
                $chartBottom = 45;
                $plotWidth = $chartWidth - $chartLeft - $chartRight;
                $plotHeight = $chartHeight - $chartTop - $chartBottom;
                $pointCount = count($revenueTrend);
                $chartPoints = [];
                foreach ($revenueTrend as $index => $trend):
                    $x = $pointCount > 1 ? $chartLeft + ($index / ($pointCount - 1)) * $plotWidth : $chartLeft + ($plotWidth / 2);
                    $y = $chartTop + $plotHeight - (((float)$trend['revenue'] / $maxTrendRevenue) * $plotHeight);
                    $chartPoints[] = [
                        'x' => $x,
                        'y' => $y,
                        'label' => $trend['label'],
                        'date' => $trend['date'],
                        'revenue' => (float)$trend['revenue']
                    ];
                endforeach;
                $polylinePoints = implode(' ', array_map(static function (array $point): string {
                    return number_format($point['x'], 2, '.', '') . ',' . number_format($point['y'], 2, '.', '');
                }, $chartPoints));
                $labelStep = max(1, (int)ceil($pointCount / 7));
                ?>
                <div class="kci-line-chart-wrap">
                    <svg class="kci-line-chart" viewBox="0 0 1000 250" role="img" aria-label="<?= $block->escapeHtmlAttr(__('Daily revenue trend')) ?>" preserveAspectRatio="none">
                        <?php for ($grid = 0; $grid <= 4; $grid++): ?>
                            <?php $gridY = $chartTop + ($plotHeight / 4) * $grid; ?>
                            <line x1="<?= $chartLeft ?>" y1="<?= number_format($gridY, 2, '.', '') ?>" x2="<?= $chartWidth - $chartRight ?>" y2="<?= number_format($gridY, 2, '.', '') ?>" class="kci-chart-gridline" />
                        <?php endfor; ?>
                        <?php if (count($chartPoints) > 1): ?>
                            <polyline points="<?= $block->escapeHtmlAttr($polylinePoints) ?>" class="kci-chart-area-line" />
                        <?php endif; ?>
