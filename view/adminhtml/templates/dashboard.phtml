/** @var \Kumar\CommerceIntelligence\Block\Adminhtml\Dashboard $block */

$stats = $block->getStats();

if (!is_array($stats)) {
    $stats = [];
}

$stats = array_replace(
    [
        'revenue' => 0.0,
        'orders' => 0,
        'aov' => 0.0,
        'customers' => 0,
        'refunds' => 0.0,
        'discounts' => 0.0,
        'payment_distribution' => [],
        'hero_products' => [],
        'peak_hours' => [],
        'revenue_trend' => [],
        'registered_orders' => 0,
        'guest_orders' => 0,
        'repeat_customers' => 0,
        'order_statuses' => [],
        'comparison' => []
    ],
    $stats
);

$period = $block->getPeriod();

$revenue = (float)$stats['revenue'];
$orders = (int)$stats['orders'];
$aov = (float)$stats['aov'];
$customers = (int)$stats['customers'];
$refunds = (float)$stats['refunds'];
$discounts = (float)$stats['discounts'];

$paymentDistribution = is_array($stats['payment_distribution'])
    ? $stats['payment_distribution']
    : [];

$heroProducts = is_array($stats['hero_products'])
    ? $stats['hero_products']
    : [];

$peakHours = is_array($stats['peak_hours'])
    ? $stats['peak_hours']
    : [];

$revenueTrend = is_array($stats['revenue_trend'])
    ? $stats['revenue_trend']
    : [];

$maxTrendRevenue = $block->getMaxTrendRevenue();

$maxPeakOrders = $block->getMaxPeakOrders();
$comparison = $stats['comparison'];
$orderStatuses = is_array($stats['order_statuses']) ? $stats['order_statuses'] : [];

$comparisonRevenueChange = $block->getPercentageChange($revenue, (float)($comparison['revenue'] ?? 0));
$comparisonOrdersChange = $block->getPercentageChange((float)$orders, (float)($comparison['orders'] ?? 0));
$comparisonAovChange = $block->getPercentageChange($aov, (float)($comparison['aov'] ?? 0));

$refundPercentage = $revenue > 0
    ? ($refunds / $revenue) * 100
    : 0;

$discountPercentage = $revenue > 0
    ? ($discounts / $revenue) * 100
    : 0;
