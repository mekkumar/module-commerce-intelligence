                            <circle cx="<?= number_format($point['x'], 2, '.', '') ?>" cy="<?= number_format($point['y'], 2, '.', '') ?>" r="<?= $pointCount <= 30 ? 4 : 2.5 ?>" class="kci-chart-point">
                                <title><?= $block->escapeHtml($point['date'] . ' · ' . $block->formatPrice($point['revenue'])) ?></title>
                            </circle>
                            <?php if ($index % $labelStep === 0 || $index === $pointCount - 1): ?>
                                <text x="<?= number_format($point['x'], 2, '.', '') ?>" y="235" text-anchor="middle" class="kci-chart-label"><?= $block->escapeHtml($point['label']) ?></text>
                            <?php endif; ?>
                        <?php endforeach; ?>
